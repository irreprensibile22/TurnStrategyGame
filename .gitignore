# Unreal Engine .gitignore

# Folders generated by the engine / build
Binaries/
Intermediate/
Saved/
DerivedDataCache/

# IDE files
.vs/
.vscode/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# Temp files
*.tmp
*.autosave

# Cooked builds / packaging
/Build/
*.pdf

# Unreal demo content, not used by the project
Content/StarterContent/
